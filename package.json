{
  "name": "obscura",
  "private": true,
  "version": "0.1.0",
  "description": "Confidential Wrapper Registry App \u2014 browse, wrap, unwrap, and decrypt ERC-7984 confidential tokens on Sepolia",
  "scripts": {
    "dev": "node init && turbo run dev",
    "build": "node init && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "nextra": {
      "zod": "4.1.12"
    },
    "nextra-theme-docs": {
      "zod": "4.1.12"
    }
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  }
}
